TIME_OF_TURN90 = 2
TIME_OF_TURN180 = 3

# Cost for spatial and temporal movements of nodes in a star algorithm
SPATIAL_COST = 10 
TEMPORAL_COST = 10

# 按充10分钟跑1小时来算，满电是3600，代表可以跑大概3600秒（粗略估计，直线行驶按1秒消耗1电，转弯按1秒消耗2电）
FULL_CHARGE = 3600  
# 电量消耗速度/s
BATTERY_CONSUMING_SPEED = 1  


# AGV抬起及放下货架时长
LIFTING_TIME = 4  
# 每辆AGV的购入及维护成本(极智嘉M200) * 1.05是假设维护成本为购入价格的5%，然后均摊到每秒
AGV_COST = 75000 * 1.05 / 5 / 365 / 24 / 3600
# 每个充电桩的成本为20000元
CHARGING_STATION_COST = 20000 / 5 / 365 / 24 / 3600  
# 分拣工人每秒薪资
WORKER_COST = 34 / 3600  
  